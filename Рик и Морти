    ctx.fillStyle = '#a00000'; ctx.beginPath(); ctx.moveTo(f.x + 50, f.y); ctx.lineTo(f.x + 100, f.y + 100); ctx.lineTo(f.x, f.y + 100); ctx.fill(); ctx.fillStyle = '#ff0000'; ctx.beginPath(); ctx.arc(f.x + 50, f.y + 50, 20, 0, Math.PI*2); ctx.fill();
  }
  
  if (f.type !== 'rug_blue' && f.type !== 'rug_pink' && f.type !== 'rug_red' && f.type !== 'poster_ball' && f.type !== 'poster_alien' && f.type !== 'mirror' && f.type !== 'tires') {
    ctx.strokeStyle = 'rgba(0,0,0,0.5)'; ctx.lineWidth = 2; ctx.strokeRect(f.x, f.y, f.w, f.h);
  }
}

function isColliding(x, y) {
  if (x - player.r < 30 || x + player.r > W - 30 || y - player.r < 30 || y + player.r > H - 30) return true;
  const room = rooms[currentRoom];
  for (const f of room.furniture) {
    if (!f.solid) continue;
    if (x + player.r > f.x && x - player.r < f.x + f.w && y + player.r > f.y && y - player.r < f.y + f.h) return true;
  }
  return false;
}

function render() {
  if (gameState === 'menu' || gameState === 'paused') return;
  const room = rooms[currentRoom];

  ctx.fillStyle = room.floor; ctx.fillRect(0, 0, W, H);
  if (currentRoom === 'kitchen') {
    ctx.strokeStyle = 'rgba(0,0,0,0.05)'; ctx.lineWidth = 2;
    for (let x = 0; x < W; x += 50) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (let y = 0; y < H; y += 50) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
  } else if (currentRoom === 'citadel') {
    ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 2;
    for (let x = 0; x < W; x += 100) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (let y = 0; y < H; y += 100) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
  } else if (room.floor === '#d9a761' || room.floor === '#c49a6c') {
    ctx.strokeStyle = 'rgba(0,0,0,0.1)'; ctx.lineWidth = 2;
    for (let x = 0; x < W; x += 80) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
  }

  ctx.fillStyle = '#111'; ctx.fillRect(0, 0, W, 30); ctx.fillRect(0, H - 30, W, 30); ctx.fillRect(0, 0, 30, H); ctx.fillRect(W - 30, 0, 30, H);

  // Декор (фон)
  for (const d of room.decor || []) {
    ctx.font = '30px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.globalAlpha = 0.6;
    ctx.fillText(d.emoji, d.x, d.y);
    ctx.globalAlpha = 1.0;
  }

  for (const door of room.doors) {
