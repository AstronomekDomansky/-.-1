    } else if (e.type === 'item') {
      const isNear = Math.hypot(player.x - e.x, player.y - e.y) < 130;
      if (isNear) { ctx.fillStyle = 'rgba(107, 255, 107, 0.3)'; ctx.beginPath(); ctx.arc(e.x, e.y, 25 + Math.sin(Date.now()/150)*5, 0, Math.PI*2); ctx.fill(); }
      const bob = Math.sin(Date.now() / 200) * 5;
      ctx.font = '44px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(e.emoji, e.x, e.y + bob);
    }
  }

  if (rickCompanion.active && currentRoom !== 'garage' && currentRoom !== 'citadel' && currentRoom !== 'cronenberg' && currentRoom !== 'purge') {
    drawCharacter(rickCompanion.x, rickCompanion.y, 'rick');
    ctx.font = 'bold 18px sans-serif'; ctx.fillStyle = '#fff'; ctx.textAlign = 'center';
    ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
    ctx.strokeText('Рик', rickCompanion.x, rickCompanion.y - 45); ctx.fillText('Рик', rickCompanion.x, rickCompanion.y - 45);
  }

  for (const en of enemies) {
    if (en.room !== currentRoom) continue;
    if (en.type === 'boss') {
