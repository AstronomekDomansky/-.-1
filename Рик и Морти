    for (let n = 0; n < words.length; n++) {
      const testLine = line + words[n] + ' ';
      if (ctx.measureText(testLine).width > W - 180 && n > 0) {
        ctx.fillText(line, 90, y); line = words[n] + ' '; y += 30;
      } else { line = testLine; }
    }
    ctx.fillText(line, 90, y);

    ctx.fillStyle = '#6bff6b'; ctx.font = 'italic 14px sans-serif'; ctx.textAlign = 'right';
    ctx.fillText('[E] — далее', W - 90, H - 55);
  }
}

function update() {
  if (gameState !== 'playing') return;
  gameTime += 1;
  player.invuln = Math.max(0, player.invuln - 1);
  player.teleportCooldown = Math.max(0, player.teleportCooldown - 1);

  if (dialogueQueue.length > 0) return;

  let dx = 0, dy = 0;
  if (keys['w'] || keys['arrowup'] || keys['ц']) dy = -player.speed;
  if (keys['s'] || keys['arrowdown'] || keys['ы']) dy = player.speed;
  if (keys['a'] || keys['arrowleft'] || keys['ф']) dx = -player.speed;
  if (keys['d'] || keys['arrowright'] || keys['в']) dx = player.speed;

  if (dx > 0) player.facing = 1; else if (dx < 0) player.facing = -1;

  const nextX = player.x + dx;
  const nextY = player.y + dy;
  
  const room = rooms[currentRoom];

  if (rickCompanion.active && currentRoom !== 'garage' && currentRoom !== 'citadel' && currentRoom !== 'cronenberg' && currentRoom !== 'purge') {
    const rdx = player.x - rickCompanion.x - 40;
    const rdy = player.y - rickCompanion.y;
    const dist = Math.hypot(rdx, rdy);
    if (dist > 50) {
      rickCompanion.x += (rdx / dist) * rickCompanion.speed;
      rickCompanion.y += (rdy / dist) * rickCompanion.speed;
    }
    if (rdx > 0) rickCompanion.facing = 1; else rickCompanion.facing = -1;
  }

  if (currentRoom === 'garage' && storyStage >= 5) {
    const distToPortal = Math.hypot(player.x - 500, player.y - 300);
    if (distToPortal < 50) {
      if (storyStage === 5) {
        currentRoom = 'citadel'; player.x = 580; player.y = 480; player.teleportCooldown = 60; storyStage = 6; sfxPortal();
      } else if (storyStage === 9) {
        currentRoom = 'cronenberg'; player.x = 580; player.y = 480; player.teleportCooldown = 60; storyStage = 10; sfxPortal();
      } else if (storyStage === 12) {
        currentRoom = 'purge'; player.x = 580; player.y = 480; player.teleportCooldown = 60; storyStage = 13; sfxPortal();
      }
      return;
    }
  }

  if (player.teleportCooldown <= 0) {
    for (const door of room.doors) {
      if (player.x + player.r > door.x && player.x - player.r < door.x + door.w &&
          player.y + player.r > door.y && player.y - player.r < door.y + door.h) {
        
        if (door.isPortal && storyStage < 5) continue;

        currentRoom = door.target; player.x = door.spawnX; player.y = door.spawnY; player.teleportCooldown = 60; sfxPortal();
        
        if (rickCompanion.active) {
          rickCompanion.x = player.x + 40; rickCompanion.y = player.y;
        }
        return; 
      }
    }
  }

  if (!isColliding(nextX, player.y)) player.x = nextX;
  if (!isColliding(player.x, nextY)) player.y = nextY;

  if (mouse.down && gameTime % 10 === 0) {
    const angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
    bullets.push({ x: player.x, y: player.y, vx: Math.cos(angle) * 15, vy: Math.sin(angle) * 15, life: 60, damage: 20 });
    sfxShoot();
  }

  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.x += b.vx; b.y += b.vy; b.life--;
    if (b.life <= 0 || b.x < 0 || b.x > W || b.y < 0 || b.y > H) { bullets.splice(i, 1); continue; }
    
    for (let j = enemies.length - 1; j >= 0; j--) {
      const e = enemies[j];
      if (e.room !== currentRoom) continue; 
      
      if (Math.hypot(b.x - e.x, b.y - e.y) < 30) {
        e.hp -= b.damage; bullets.splice(i, 1);
        sfxHit();
        for (let k=0; k<5; k++) particles.push({x: e.x, y: e.y, vx: (Math.random()-0.5)*10, vy: (Math.random()-0.5)*10, life: 20, color: '#ff3b3b'});
        if (e.hp <= 0) {
          if (e.type === 'boss') { 
            if (storyStage === 15) {
              storyStage = 16;
              dialogueQueue = ["Злой Морти: Ты думаешь, ты победил? Я только начал!", "Рик: Морти, он вошел во вторую фазу! Стреляй!"];
              speak("Ты думаешь, ты победил? Я только начал!", 'evil_morty');
              e.hp = 2000; e.maxHp = 2000; e.speed = 3;
            } else {
              storyStage = 17; gameState = 'win'; endOverlay.classList.remove('hidden'); 
              endTitle.textContent = "ПОБЕДА!"; endText.textContent = "Ты убил Злого Морти. Рик тобой гордится (наверное)."; 
            }
          } else { 
            enemies.splice(j, 1); 
            if (storyStage === 3) alienKills++;
          }
        }
      }
    }
  }

  for (let i = enemyBullets.length - 1; i >= 0; i--) {
    const b = enemyBullets[i];
    if (b.room !== currentRoom) continue;
    b.x += b.vx; b.y += b.vy; b.life--;
    if (b.life <= 0 || b.x < 0 || b.x > W || b.y < 0 || b.y > H) { enemyBullets.splice(i, 1); continue; }
    if (Math.hypot(b.x - player.x, b.y - player.y) < 30 && player.invuln <= 0) {
      player.hp -= 15; player.invuln = 60; sfxHit(); enemyBullets.splice(i, 1);
    }
  }

  for (const e of enemies) {
    if (e.room !== currentRoom) continue;
    const edx = player.x - e.x, edy = player.y - e.y, dist = Math.hypot(edx, edy);
    
    if (e.type === 'shooter_alien' || e.type === 'citadel_guard' || e.type === 'enemy') {
       if (dist > 200) { e.x += (edx/dist) * e.speed; e.y += (edy/dist) * e.speed; }
       if (dist < 400 && gameTime % 60 === 0) {
         const angle = Math.atan2(player.y - e.y, player.x - e.x);
         enemyBullets.push({x: e.x, y: e.y, vx: Math.cos(angle)*8, vy: Math.sin(angle)*8, life: 100, room: currentRoom});
       }
    } else {
       if (dist > e.r + player.r) { e.x += (edx/dist) * e.speed; e.y += (edy/dist) * e.speed; }
    }

    if (dist < e.r + player.r && player.invuln <= 0) { 
      player.hp -= 10; player.invuln = 60; sfxHit();
    }
  }

  if (player.hp <= 0) { 
    gameState = 'dead'; endOverlay.classList.remove('hidden'); 
    endTitle.textContent = "ТЫ УМЕР"; endText.textContent = "Морти сдох. Рик даже не заметит. Или заметит, но ему будет похуй."; 
  }

  if (storyStage === 3 && alienKills >= totalAliensToKill) {
    storyStage = 4;
    alienKills = totalAliensToKill; 
    if (alienSpawnTimer) { clearInterval(alienSpawnTimer); alienSpawnTimer = null; }
    enemies = enemies.filter(e => e.type === 'boss');
    rifts = [];
    
    dialogueQueue = [
      "Рик: Охуенно, Морти! Ты зачистил дом!",
      "Рик: Но для стабилизации портала нужна батарейка из Цитадели.",
      "Рик: Иди в гараж, прыгай в портал и принеси её."
    ];
    speak("Охуенно, Морти! Ты зачистил дом!", 'rick');
  }
}

function spawnBoss() {
  enemies.push({x: 200, y: 200, room: 'garage', type: 'boss', hp: 1000, maxHp: 1000, speed: 2, r: 40});
  dialogueQueue = [
    "Злой Морти: Привет, Рик. Я пришел за твоим порталом.",
    "Рик: Морти, убей его!"
  ];
  speak("Привет, Рик. Я пришел за твоим порталом.", 'evil_morty');
}

function interact() {
  if (dialogueQueue.length > 0) {
    dialogueQueue.shift();
    if (dialogueQueue.length > 0) {
      speak(getCleanText(dialogueQueue[0]), getSpeakerId(dialogueQueue[0]));
    }
    return;
  }

  const room = rooms[currentRoom];
  
  let closest = null;
  let minDist = 130;
  
  for (const e of room.entities || []) {
    if (e.type === 'item' && inv.has(e.id)) continue;
    if (e.type === 'enemy') continue;
    const dist = Math.hypot(player.x - e.x, player.y - e.y);
    if (dist < minDist) { minDist = dist; closest = {type: e.type, data: e}; }
  }
  
  if (!closest) {
    for (const p of room.props || []) {
      const dist = Math.hypot(player.x - p.x, player.y - p.y);
      if (dist < minDist) { minDist = dist; closest = {type: 'prop', data: p}; }
    }
  }

  if (closest) {
    const target = closest.data;
    
    if (closest.type === 'prop') {
      const randomDialog = target.dialogs[Math.floor(Math.random() * target.dialogs.length)];
      dialogueQueue = [randomDialog];
      speak(getCleanText(randomDialog), 'morty');
    } 
    else if (closest.type === 'npc') {
      if (target.id === 'rick') {
        if (storyStage === 0) {
          dialogueQueue = ["Рик: Морти! Я случайно открыл портал в измерение Кроненберга.", "Рик: И оттуда лезут твари. Тащи мне 8 предметов для пушки.", "Рик: Батарейку, флягу, ключ, ключи Джерри, соус, учебник, пиццу и селфи-палку. Живо!", "Морти: О-о-о, чувак... Опять?"];
          storyStage = 1; rickCompanion.active = true;
        } else if (storyStage === 1) {
          dialogueQueue = ["Рик: Ты нашел 8 предметов? Нет? Тогда какого хера ты тут стоишь?"];
        } else if (storyStage === 2) {
          dialogueQueue = ["Рик: Охуеть, ты всё нашел!", "Рик: Ща починю... Готово!", "Рик: Ой, блядь. Из-за нестабильности открылись портальные разломы!", "Рик: Морти, убей 15 Громфломитов, которые лезут из них! Иначе они нас сожрут!"];
          storyStage = 3; alienKills = 0; totalAliensToKill = 15;
          
          if (alienSpawnTimer) clearInterval(alienSpawnTimer);
          alienSpawnTimer = setInterval(() => {
            if (storyStage === 3 && (enemies.length + alienKills) < 15) {
              let spawnX, spawnY;
              do {
                 spawnX = Math.random() * 800 + 80;
                 spawnY = Math.random() * 400 + 80;
              } while (Math.hypot(spawnX - player.x, spawnY - player.y) < 200);
              
              rifts.push({x: spawnX, y: spawnY, life: 60});
              
              setTimeout(() => {
                  if (storyStage === 3) {
                    let type = 'alien'; let hp = 50; let speed = 2;
                    if (Math.random() > 0.7) { type = 'fast_alien'; hp = 30; speed = 4; }
                    if (Math.random() > 0.8) { type = 'tank_alien'; hp = 150; speed = 1.5; }
                    if (Math.random() > 0.9) { type = 'shooter_alien'; hp = 80; speed = 2; }
                    enemies.push({x: spawnX, y: spawnY, room: currentRoom, type: type, hp: hp, maxHp: hp, speed: speed, r: 15});
                  }
              }, 600);
              
            } else if (storyStage === 3 && (enemies.length + alienKills) >= 15) {
              clearInterval(alienSpawnTimer); alienSpawnTimer = null;
            }
          }, 1500);
        } else if (storyStage === 4) {
          dialogueQueue = ["Рик: Портал открыт. Прыгай в него, идиот! Тебе нужна батарейка из Цитадели."];
          storyStage = 5;
        } else if (storyStage === 7) {
          dialogueQueue = ["Рик: Батарейка! Отлично.", "Рик: Вставляем... *бип* ...готово!", "Рик: Но стабилизатор сломан. Злой Морти украл ядро! Прыгай в Кроненберг-мир и найди стабилизатор!"];
          storyStage = 9;
        } else if (storyStage === 11) {
          dialogueQueue = ["Рик: Стабилизатор! Отлично.", "Рик: Вставляем... *бип* ...готово!", "Рик: Осталось последнее. Мне нужен Кристалл Пурги, чтобы пробить защиту логова Злого Морти. Прыгай на Планету Пурги!"];
          storyStage = 12;
        } else if (storyStage === 14) {
          dialogueQueue = ["Рик: Кристалл! Отлично.", "Рик: Вставляем... *бип* ...готово!", "Злой Морти: Привет, Рик. Я пришел за твоим порталом.", "Рик: Морти, убей его!"];
          storyStage = 15; spawnBoss();
        }
      } else if (target.id === 'president') {
        if (storyStage === 6) {
          dialogueQueue = ["Президент: Морти? Что ты здесь делаешь?", "Морти: Мне нужна батарейка для портала Рика.", "Президент: Хорошо, забирай. Но знай, Злой Морти украл наше главное ядро. Будьте осторожны."];
          inv.add('citadel_battery'); storyStage = 7;
          dialogueQueue.push("Морти: О-о-о, спасибо!");
        }
      } else if (target.id === 'jerry') {
        if (storyStage === 0) dialogueQueue = ["Джерри: Морти, ты не видел мои ключи? Я их вечно теряю."];
        else if (storyStage === 1) dialogueQueue = ["Джерри: Морти, ты не видел мои ключи? Они где-то в гостиной."];
        else if (storyStage === 3) dialogueQueue = ["Джерри: Морти, монстры! Спаси меня!"];
        else dialogueQueue = ["Джерри: Морти, а можно мне тоже с порталом? Ну пожалуйста!"];
      } else if (target.id === 'summer') {
        if (storyStage === 0) dialogueQueue = ["Саммер: Морти, отвали! У меня важный пост в инсте!"];
        else if (storyStage === 1) dialogueQueue = ["Саммер: Морти, не трогай мой шкаф!"];
        else if (storyStage === 3) dialogueQueue = ["Саммер: Морти, тут монстры! Убей их!"];
        else dialogueQueue = ["Саммер: Морти, ты меня достал."];
      } else if (target.id === 'beth') {
        if (storyStage === 3) dialogueQueue = ["Бэт: Морти, будь осторожнее. Эти твари кусаются!"];
        else dialogueQueue = [target.dialog];
      } else {
        dialogueQueue = [target.dialog];
      }
      
      if (dialogueQueue.length > 0) speak(getCleanText(dialogueQueue[0]), getSpeakerId(dialogueQueue[0]));
    } 
    else if (closest.type === 'item') {
      let canPickup = false;
      const itemsToFind = ['book', 'pizza', 'selfie', 'battery', 'flask', 'wrench', 'jerry_keys', 'szechuan'];
      
      if (storyStage === 1 && itemsToFind.includes(target.id)) canPickup = true;
      if (storyStage === 6 && target.id === 'citadel_battery') canPickup = true;
      if (storyStage === 10 && target.id === 'stabilizer') canPickup = true;
      if (storyStage === 13 && target.id === 'purge_crystal') canPickup = true;

      if (!canPickup) {
        dialogueQueue = ["Морти: Мне это сейчас не нужно."];
        speak("Мне это сейчас не нужно.", 'morty');
        return;
      }

      inv.add(target.id); sfxPickup();
      
      if (target.id === 'citadel_battery') {
        dialogueQueue = ["Морти: Батарейка из Цитадели! Пора возвращаться."];
        speak("Батарейка из Цитадели! Пора возвращаться.", 'morty');
      } else if (target.id === 'stabilizer') {
        dialogueQueue = ["Морти: Стабилизатор! Надо отдать Рику."];
        speak("Стабилизатор! Надо отдать Рику.", 'morty');
        storyStage = 11;
      } else if (target.id === 'purge_crystal') {
        dialogueQueue = ["Морти: Кристалл Пурги! Надо отдать Рику."];
        speak("Кристалл Пурги! Надо отдать Рику.", 'morty');
        storyStage = 14;
      } else {
        const randomPrefix = mortyItemLines[Math.floor(Math.random() * mortyItemLines.length)];
        dialogueQueue = ["Морти: " + randomPrefix + target.name + "!"];
        speak(randomPrefix + target.name + "!", 'morty');
      }
      
      let count = 0;
      for (const item of itemsToFind) { if (inv.has(item)) count++; }
      if (count === 8 && storyStage === 1) storyStage = 2;
    }
  }
}

document.addEventListener('keydown', (e) => {
  const k = e.key.toLowerCase();
  if (k === 'escape' && gameState === 'playing') { gameState = 'paused'; pauseOverlay.classList.remove('hidden'); return; }
  if (k === 'escape' && gameState === 'paused') { gameState = 'playing'; pauseOverlay.classList.add('hidden'); return; }
  
  if (k === 'e' || k === 'у') {
    if (dialogueQueue.length > 0) interact();
    else if (gameState === 'playing') interact();
    return;
  }

  if (gameState !== 'playing') return;
  keys[k] = true;
  
  if (k === ' ' && gameState === 'playing') { mouse.down = true; e.preventDefault(); }
});

document.addEventListener('keyup', (e) => {
  const k = e.key.toLowerCase();
  keys[k] = false;
  if (k === ' ') mouse.down = false;
});

canvas.addEventListener('mousemove', (e) => {
  const rect = canvas.getBoundingClientRect();
  mouse.x = (e.clientX - rect.left) * (W / rect.width);
  mouse.y = (e.clientY - rect.top) * (H / rect.height);
});

canvas.addEventListener('mousedown', (e) => { if (e.button === 0) mouse.down = true; });
canvas.addEventListener('mouseup', (e) => { if (e.button === 0) mouse.down = false; });

startBtn.addEventListener('click', () => {
  try { initAudio(); } catch(e) {}
  startOverlay.classList.add('hidden'); gameState = 'playing';
});

restartBtn.addEventListener('click', () => { window.speechSynthesis.cancel(); window.location.reload(); });
resumeBtn.addEventListener('click', () => { gameState = 'playing'; pauseOverlay.classList.add('hidden'); });
stuckBtn.addEventListener('click', () => {
  player.x = 480; player.y = 300;
  if (rickCompanion.active) { rickCompanion.x = player.x + 40; rickCompanion.y = player.y; }
  pauseOverlay.classList.add('hidden'); gameState = 'playing';
});

function loop() { 
  update(); 
  if (rifts.length > 0) {
    for (let i = rifts.length - 1; i >= 0; i--) {
        rifts[i].life--;
        if (rifts[i].life <= 0) rifts.splice(i, 1);
    }
  }
  render(); 
  requestAnimationFrame(loop); 
}
loop();
</script>
</body>
</html>
