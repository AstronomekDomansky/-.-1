function initAudio() {
  try {
    if (!actx && AudioContext) actx = new AudioContext();
    if (actx && actx.state === 'suspended') actx.resume();
    startBGM();
  } catch (e) {}
}

function playSound(type, freq, duration, vol) {
  try {
    if (!actx) return;
    const osc = actx.createOscillator();
    const gain = actx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, actx.currentTime);
    gain.gain.setValueAtTime(vol, actx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, actx.currentTime + duration);
    osc.connect(gain); gain.connect(actx.destination);
    osc.start(); osc.stop(actx.currentTime + duration);
  } catch(e) {}
}

function sfxShoot() { playSound('square', 800, 0.1, 0.1); playSound('sawtooth', 400, 0.15, 0.05); }
function sfxHit() { playSound('sawtooth', 150, 0.2, 0.1); }
function sfxPickup() { playSound('sine', 600, 0.1, 0.1); setTimeout(() => playSound('sine', 800, 0.1, 0.1), 50); }
function sfxPortal() { playSound('sine', 200, 0.5, 0.1); playSound('sine', 600, 0.5, 0.1); }

let noteIndex = 0;
const bassLine = [110, 110, 165, 110, 130, 130, 196, 130];
const melody = [440, 0, 523, 440, 392, 0, 330, 392];

function playBgmNote() {
  try {
    if (!actx || !isPlayingMusic) return;
    const t = actx.currentTime;
    const oscBass = actx.createOscillator();
    const gainBass = actx.createGain();
    oscBass.type = 'sawtooth'; oscBass.frequency.value = bassLine[noteIndex % bassLine.length];
    gainBass.gain.setValueAtTime(0.05, t); gainBass.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
    oscBass.connect(gainBass); gainBass.connect(actx.destination);
    oscBass.start(t); oscBass.stop(t + 0.3);

    const mFreq = melody[noteIndex % melody.length];
    if (mFreq > 0) {
      const oscMel = actx.createOscillator();
      const gainMel = actx.createGain();
      oscMel.type = 'square'; oscMel.frequency.value = mFreq;
      gainMel.gain.setValueAtTime(0.03, t); gainMel.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
      oscMel.connect(gainMel); gainMel.connect(actx.destination);
      oscMel.start(t); oscMel.stop(t + 0.2);
    }
    noteIndex++;
  } catch(e) {}
}

function startBGM() {
  if (isPlayingMusic) return;
  isPlayingMusic = true;
  try {
    bgmTimer = setInterval(playBgmNote, 250);
  } catch(e) {}
}

const badWords = ["похуй", "блядь", "хуй", "пиздец", "ебать", "заебись", "охуеть", "дерьмо", "долбоеб", "сука", "пизда", "хер", "хрен", "ебал", "нахуй", "говно", "срать", "мудак"];

function censorWordText(word) {
  if (word.length <= 2) return word;
  return word[0] + '*'.repeat(word.length - 2) + word[word.length - 1];
}

function censorText(text) {
  let censored = text;
  badWords.forEach(word => {
    const regex = new RegExp(word, 'gi');
    censored = censored.replace(regex, (match) => censorWordText(match));
  });
  return censored;
}

function censorVoiceText(text) {
  let censored = text;
  badWords.forEach(word => {
    const regex = new RegExp(word, 'gi');
    censored = censored.replace(regex, "пиииип");
  });
  return censored;
}

function speak(text, characterId) {
  try {
    if (!window.speechSynthesis) return;
    window.speechSynthesis.cancel();
    const cleanText = censorVoiceText(getCleanText(text));
    const utterance = new SpeechSynthesisUtterance(cleanText);
    
    if (characterId === 'rick') { utterance.pitch = 0.3; utterance.rate = 1.1; } 
    else if (characterId === 'morty') { utterance.pitch = 1.8; utterance.rate = 1.2; } 
    else if (characterId === 'jerry') { utterance.pitch = 1.0; utterance.rate = 0.9; } 
    else if (characterId === 'summer') { utterance.pitch = 1.4; utterance.rate = 1.0; } 
    else if (characterId === 'beth') { utterance.pitch = 1.1; utterance.rate = 1.0; }
    else if (characterId === 'poopy') { utterance.pitch = 1.6; utterance.rate = 1.2; }
    else if (characterId === 'birdperson') { utterance.pitch = 0.5; utterance.rate = 0.9; }
    else if (characterId === 'squanchy') { utterance.pitch = 0.8; utterance.rate = 1.3; }
    else if (characterId === 'evil_morty') { utterance.pitch = 1.7; utterance.rate = 0.8; }
    else if (characterId === 'president') { utterance.pitch = 1.0; utterance.rate = 1.1; }
    
    window.speechSynthesis.speak(utterance);
  } catch(e) {}
}

function getCleanText(text) {
  const colonIndex = text.indexOf(':');
  if (colonIndex !== -1) return text.slice(colonIndex + 1).trim();
  return text;
}

function getSpeakerId(text) {
  if (text.startsWith("Рик")) return 'rick';
  if (text.startsWith("Морти")) return 'morty';
  if (text.startsWith("Джерри")) return 'jerry';
  if (text.startsWith("Саммер")) return 'summer';
  if (text.startsWith("Бэт")) return 'beth';
  if (text.startsWith("Мистер")) return 'poopy';
  if (text.startsWith("Птичья")) return 'birdperson';
  if (text.startsWith("Сквончи")) return 'squanchy';
  if (text.startsWith("Злой Морти")) return 'evil_morty';
  if (text.startsWith("Президент")) return 'president';
  return 'other';
}

