    } else {
        drawCharacter(en.x, en.y, en.type);
    }
    ctx.fillStyle = 'red'; ctx.fillRect(en.x - 20, en.y - 45, 40, 6);
    ctx.fillStyle = 'lime'; ctx.fillRect(en.x - 20, en.y - 45, 40 * (en.hp / en.maxHp), 6);
  }

  for (const b of bullets) {
    ctx.fillStyle = '#6bff6b'; ctx.beginPath(); ctx.arc(b.x, b.y, 6, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(b.x, b.y, 3, 0, Math.PI*2); ctx.fill();
  }
  for (const b of enemyBullets) {
    if (b.room !== currentRoom) continue;
    ctx.fillStyle = '#ff3b3b'; ctx.beginPath(); ctx.arc(b.x, b.y, 8, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(b.x, b.y, 4, 0, Math.PI*2); ctx.fill();
  }

  drawCharacter(player.x, player.y, 'morty');
  ctx.font = 'bold 18px sans-serif'; ctx.fillStyle = '#f4e87c'; ctx.textAlign = 'center';
  ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
  ctx.strokeText('Морти', player.x, player.y - 45); ctx.fillText('Морти', player.x, player.y - 45);

  // HUD
  ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.fillRect(15, 15, 280, 40);
  ctx.strokeStyle = '#6bff6b'; ctx.lineWidth = 2; ctx.strokeRect(15, 15, 280, 40);
  ctx.fillStyle = '#6bff6b'; ctx.font = 'bold 20px sans-serif'; ctx.textAlign = 'left';
  ctx.fillText(room.name, 25, 42);

  ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.fillRect(15, 65, 300, 30);
  ctx.strokeStyle = '#6bff6b'; ctx.strokeRect(15, 65, 300, 30);
  ctx.fillStyle = player.hp > 30 ? '#6bff6b' : '#ff3b3b';
  ctx.fillRect(17, 67, 296 * (player.hp / player.maxHp), 26);
  ctx.fillStyle = '#000'; ctx.font = 'bold 16px sans-serif'; ctx.textAlign = 'center';
  ctx.fillText(`HP: ${Math.ceil(player.hp)} / 100`, 165, 85);

  ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.fillRect(15, 105, 650, 40);
  ctx.strokeStyle = '#6bff6b'; ctx.strokeRect(15, 105, 650, 40);
  ctx.fillStyle = '#fff'; ctx.font = '16px sans-serif'; ctx.textAlign = 'left';
  
  let qText = "";
  if (storyStage === 0) qText = "Поговори с Риком в гараже.";
  else if (storyStage === 1) {
      let missing = [];
      if (!inv.has('book')) missing.push('Учебник');
      if (!inv.has('pizza')) missing.push('Пицца');
      if (!inv.has('selfie')) missing.push('Селфи-палка');
      if (!inv.has('battery')) missing.push('Батарейка');
      if (!inv.has('flask')) missing.push('Фляга');
      if (!inv.has('wrench')) missing.push('Ключ');
      if (!inv.has('jerry_keys')) missing.push('Ключи Джерри');
      if (!inv.has('szechuan')) missing.push('Соус');
      
      if (missing.length > 0) {
          qText = "Найди: " + missing.join(', ');
      } else {
          qText = "Все предметы найдены! Вернись к Рику.";
      }
  }
  else if (storyStage === 2) qText = "Вернись к Рику в гараж!";
  else if (storyStage === 3) qText = `Убей Громфломитов! (${alienKills} / ${totalAliensToKill})`;
  else if (storyStage === 4) qText = "Поговори с Риком (он в гараже).";
  else if (storyStage === 5) qText = "Прыгай в фиолетовый портал в гараже.";
  else if (storyStage === 6) qText = "Найди Президента Цитадели и забери батарейку.";
  else if (storyStage === 7) qText = "Вернись к Рику в гараж.";
  else if (storyStage === 9) qText = "Прыгай в портал и лети в Кроненберг-мир.";
  else if (storyStage === 10) qText = "Найди Стабилизатор и вернись.";
  else if (storyStage === 11) qText = "Поговори с Риком.";
  else if (storyStage === 12) qText = "Прыгай в портал и лети на Планету Пурги.";
  else if (storyStage === 13) qText = "Найди Кристалл Пурги и вернись.";
  else if (storyStage === 14) qText = "Поговори с Риком.";
  else if (storyStage >= 15) qText = "Убей Злого Морти!";
  ctx.fillText(qText, 25, 130);

  if (interactables.length > 0) {
    const target = interactables[0];
    ctx.fillStyle = '#fff'; ctx.font = 'bold 20px sans-serif'; ctx.textAlign = 'center';
    const label = target.type === 'npc' ? 'Говорить' : 'Взаимодействовать';
    ctx.fillText(`[E] ${label}`, target.x, target.y - 70);
  }

  ctx.strokeStyle = 'rgba(107,255,107,0.5)'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.arc(mouse.x, mouse.y, 10, 0, Math.PI*2); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(mouse.x - 15, mouse.y); ctx.lineTo(mouse.x - 5, mouse.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(mouse.x + 5, mouse.y); ctx.lineTo(mouse.x + 15, mouse.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(mouse.x, mouse.y - 15); ctx.lineTo(mouse.x, mouse.y - 5); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(mouse.x, mouse.y + 5); ctx.lineTo(mouse.x, mouse.y + 15); ctx.stroke();

  if (dialogueQueue.length > 0) {
    ctx.fillStyle = 'rgba(0,0,0,0.95)'; ctx.fillRect(60, H - 160, W - 120, 120);
    ctx.strokeStyle = '#6bff6b'; ctx.lineWidth = 3; ctx.strokeRect(60, H - 160, W - 120, 120);
    ctx.fillStyle = '#eaffea'; ctx.font = '20px sans-serif'; ctx.textAlign = 'left';
    
    const text = censorText(dialogueQueue[0]);
    const words = text.split(' ');
